      "tinkerdiff_equation": "e2 = n*e1; f1 = n*f2",
      "modelica_equation": "v2 = v1/n; i2 = -i1*n",
      "modelica_info_match": "i2 = -i1*n; v2 = v1/n",
      "equation_delta": "Power-conserving two-port. MSL n is reciprocal if side labels match; MSL minus on i2 is port orientation. TinkerDiff locks f2 positive out of side 2 and n = e2/e1 > 0. Do not use Basic.Transformer (mutual L1,L2,M).",
      "validation": "pass_with_convention",
      "related_modelica_paths": [
        "Modelica.Mechanics.Rotational.Components.IdealGear"
      ]
    },
    {
      "tinkerdiff_role": "resistance_orifice",
      "element_type": "resistance",
      "resistance_form": "orifice",
