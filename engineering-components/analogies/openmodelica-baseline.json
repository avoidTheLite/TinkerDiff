      "modelica_equation": "dp = 0.5*zeta*rho*v*|v|",
      "modelica_info_match": "Δp = 0.5*ζ*ρ*v*|v|",
      "equation_delta": "Same quadratic turbulent family; parameters (Cd,A) vs (zeta,D) differ. Intentional parameterization for role dials.",
      "validation": "pass_family"
    },
    {
