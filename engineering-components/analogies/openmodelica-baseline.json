      "tinkerdiff_equation": "der(e) = f/C - gamma*e",
      "modelica_equation": "i = C * der(v)",
      "modelica_info_match": "i = C * dv/dt",
      "equation_delta": "gamma=0 matches. Nonzero gamma is parallel Conductor G=gamma*C (or Maxwell series spring-damper mechanically); not inside ideal Capacitor.",
