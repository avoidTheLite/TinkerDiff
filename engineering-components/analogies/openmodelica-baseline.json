      "validation": "intentional_simplification",
      "related_modelica_paths": [
        "Modelica.Fluid.Interfaces.PartialLumpedVolume",
        "Modelica.Electrical.Analog.Basic.Capacitor",
        "Modelica.Electrical.Analog.Basic.Conductor"
      ]
    },
    {
      "tinkerdiff_role": "mechanical_damper",
      "element_type": "resistance",
      "resistance_form": "linear",
      "modelica_path": "Modelica.Mechanics.Translational.Components.Damper",
      "doc_url": "https://doc.modelica.org/Modelica%204.0.0/Resources/helpOM/Modelica.Mechanics.Translational.Components.Damper.html",
      "tinkerdiff_equation": "e = R * f",
      "modelica_equation": "f = d * v_rel",
      "modelica_info_match": "Linear, velocity dependent damper",
      "equation_delta": "Direct match with R≡d under force–velocity effort–flow.",
      "validation": "pass_ideal"
    },
    {
      "tinkerdiff_role": "leaky_capacitance_dual",
      "element_type": "capacitance",
      "modelica_path": "Modelica.Mechanics.Translational.Components.SpringDamper",
      "doc_url": "https://doc.modelica.org/Modelica%204.0.0/Resources/helpOM/Modelica.Mechanics.Translational.Components.SpringDamper.html",
      "tinkerdiff_equation": "der(e) = f/C - gamma*e",
      "modelica_equation": "f = c*(s_rel - s_rel0) + d*v_rel",
