      "structure": {
        "operator": "failover",
        "failover_success": 0.95,
        "inputs": [
          {
            "node": "db-primary"
          },
          {
            "node": "db-standby"
          }
        ]
      }
    }
  ],
  "top_event": {
    "name": "Service unavailable",
    "structure": {
      "operator": "all",
      "inputs": [
        {
          "assembly": "edge"
        },
        {
          "assembly": "compute"
        },
        {
          "assembly": "data"
        }
      ]
    },
    "consequence": {
      "amount": {
        "family": "Point",
        "parameters": {
          "value": 10000
        }
      },
      "basis": "per_unit_time",
      "time_unit": "hour"
    }
  }
}
