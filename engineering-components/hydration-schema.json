{
  "$schema": "https://json-schema.org",
  "title": "UMLToMathematicalObjectHydrationSchema",
  "type": "object",
  "required": ["uml_component_definition", "mathematical_superposition", "quantization_routing_metadata"],
  "properties": {
    "uml_component_definition": {
      "type": "object",
      "required": ["xmi_id", "component_type", "interfaces_provided", "interfaces_required"],
      "properties": {
        "xmi_id": { "type": "string" },
        "component_type": { "type": "string", "enum": ["ComputeNode", "DatabaseNode", "EdgeTierNode", "GatewayNode"] },
        "interfaces_provided": { "type": "array", "items": { "type": "string" } },
        "interfaces_required": { "type": "array", "items": { "type": "string" } }
      }
    },
    "mathematical_superposition": {
      "type": "object",
      "required": ["calculus_layer", "statistics_pde_layer", "linear_algebra_mesh"],
      "properties": {
        "calculus_layer": {
          "type": "object",
          "required": ["state_variables", "numerical_integrator"],
          "properties": {
            "state_variables": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["initial_value", "capacity_limit", "damping_leak_coefficient"],
                "properties": {
                  "initial_value": { "type": "number" },
                  "capacity_limit": { "type": "number" },
                  "damping_leak_coefficient": { "type": "number" }
                }
              }
            },
            "numerical_integrator": { "type": "string", "enum": ["Euler", "Runge-Kutta-4", "Verlet"] }
          }
        },
        "statistics_pde_layer": {
          "type": "object",
          "required": ["laplace_operator_config", "failure_modes_fmea"],
          "properties": {
            "laplace_operator_config": {
              "type": "object",
              "required": ["advection_drift_vector", "diffusion_tensor", "reaction_cross_coupling_matrix"],
              "properties": {
                "advection_drift_vector": { "type": "array", "items": { "type": "number" } },
                "diffusion_tensor": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } },
                "reaction_cross_coupling_matrix": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } }
              }
            },
            "failure_modes_fmea": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["mode_id", "name", "mathematical_type", "rupture_disk_threshold", "hazard_distribution"],
                "properties": {
                  "mode_id": { "type": "string" },
                  "name": { "type": "string" },
                  "mathematical_type": { "type": "string", "enum": ["CapacitiveAccumulation", "ResistiveThrottle", "InductiveMomentumCollapse"] },
                  "rupture_disk_threshold": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                  "hazard_distribution": {
                    "type": "object",
                    "required": ["type", "parameters"],
                    "properties": {
                      "type": { "type": "string", "enum": ["Weibull", "Exponential", "Beta", "Lognormal"] },
                      "parameters": { "type": "object", "additionalProperties": { "type": "number" } }
                    }
                  }
                }
              }
            }
          }
        },
        "linear_algebra_mesh": {
          "type": "object",
          "required": ["input_vector_index_map", "downstream_transformation_matrix"],
          "properties": {
            "input_vector_index_map": { "type": "array", "items": { "type": "string" } },
            "downstream_transformation_matrix": {
              "type": "array",
              "items": { "type": "array", "items": { "type": "number" } }
            }
          }
        }
      }
    },
    "quantization_routing_metadata": {
      "type": "object",
      "required": ["base_quantization_tier", "drift_control_interval_cycles", "non_deterministic_boundary"],
      "properties": {
        "base_quantization_tier": { "type": "string", "enum": ["Boolean", "Algebraic", "MatrixMesh", "NumericalPDE"] },
        "drift_control_interval_cycles": { "type": "integer", "minimum": 1 },
        "non_deterministic_boundary": {
          "type": "object",
          "required": ["max_allowable_risk_entropy", "agent_routing_target_id"],
          "properties": {
            "max_allowable_risk_entropy": { "type": "number" },
            "agent_routing_target_id": { "type": "string" }
          }
        }
      }
    }
  }
}